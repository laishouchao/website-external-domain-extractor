# ==============================================================================
# 网站外部域名提取与全深度网站地图系统 - 环境配置模板 (.env.example)
# 
# 使用说明：
# 1. 复制本文件并重命名为 `.env`：
#    Windows: copy .env.example .env
#    Linux:   cp .env.example .env
# 2. 根据您的部署环境填写实际的数据库密码与运行配置。
# 3. 注意：.env 文件已被 .gitignore 永久忽略，不会被提交至任何代码仓库。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 数据库配置 (Database Settings)
# ------------------------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=website_domain_db
# 数据库连接池上限 (并发连接数)
PG_POOL_SIZE=25

# ------------------------------------------------------------------------------
# 2. Web 服务配置 (Server Settings)
# ------------------------------------------------------------------------------
# 服务监听地址 (0.0.0.0 表示允许所有外部网络访问，127.0.0.1 仅限本机)
HOST=0.0.0.0
# 服务监听端口
PORT=8000

# ------------------------------------------------------------------------------
# 3. 爬虫引擎默认配置 (Crawler Default Settings)
# ------------------------------------------------------------------------------
# 最大爬取深度 (0 表示无限制，默认 10)
CRAWLER_MAX_DEPTH=10
# 最大爬取页面数量 (0 表示无限制，默认 1000)
CRAWLER_MAX_PAGES=1000
# 爬虫并发协程数量 (推荐 35 - 50)
CRAWLER_CONCURRENCY=35
# 请求间隔延迟（秒，支持小数如 0.1，0 表示无延迟）
CRAWLER_REQUEST_DELAY=0.0
# 数据库批量写入大小 (每批入库条数，默认 50)
CRAWLER_BATCH_SIZE=50
# 单个 HTTP 请求超时时间（秒，默认 10.0）
CRAWLER_TIMEOUT=10.0
# 爬虫 User-Agent 标识
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
# 忽略 SSL 证书校验 (True / False)
CRAWLER_IGNORE_SSL=True
# 是否自动探测并解析 /sitemap.xml 和 /robots.txt (True / False)
CRAWLER_DETECT_SITEMAP=True
# 爬取域名作用域模式: 'root_domain'（同根域名及所有子域均视为站内）或 'exact_host'（仅限完全匹配主机名）
CRAWLER_SCOPE_MODE=root_domain
# 是否从页面静态资源（img/script/link/css）中提取外部域名 (True / False)
CRAWLER_EXTRACT_ASSETS=True
# 是否从页面文本内容、JS 代码段与 HTML 注释中提取外部域名 (True / False)
CRAWLER_EXTRACT_TEXT=True
# 是否直接在内存中扫描独立外链 JS/CSS 脚本文件 (True / False)
CRAWLER_SCAN_ASSET_CONTENT=True
# 允许下载并扫描的单个静态资源最大尺寸（KB，默认 3072 = 3MB）
CRAWLER_MAX_ASSET_SIZE_KB=3072
