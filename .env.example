# ==============================================================================
# Website External Domain System - Environment Configuration Template
# 复制此文件为 .env 并填写您的数据库密码与配置（.env 已被 gitignore，不会被提交）
# ==============================================================================

# Database Engine: 'postgresql' or 'sqlite'
DB_TYPE=postgresql

# PostgreSQL Configuration
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=website_domain_db
PG_POOL_SIZE=25

# Server Configuration
HOST=0.0.0.0
PORT=8000
